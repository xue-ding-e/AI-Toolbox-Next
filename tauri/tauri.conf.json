{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Toolbox Next",
  "version": "1.2.1-next.1",
  "identifier": "com.xue-ding-e.ai-toolbox-next",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "resources": [
      "licenses/AGPL-3.0.txt",
      "licenses/GPL-3.0.txt",
      "licenses/LGPL-3.0.txt",
      "licenses/NOTICE"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "aitoolbox-next"
        ]
      }
    }
  }
}
