-        }
-
-        let mut validated_segments = Vec::with_capacity(segments.len());
-        for segment in segments {
-            validate_identifier(segment)?;
-            validated_segments.push((*segment).to_string());
-        }
-
-        Ok(Self {
-            segments: validated_segments,
-        })
-    }
