+[package]
+name = "ai-toolbox-storage"
+version = "0.1.0"
+description = "Shared SQLite JSONB storage for AI Toolbox"
+license = "AGPL-3.0-or-later"
+edition = "2021"
+publish = false
+
+[dependencies]
+chrono = { version = "0.4.43", features = ["serde"] }
+log = "0.4"
+rusqlite = { version = "0.39.0", features = ["bundled", "backup", "hooks"] }
+rust_decimal = "1.39.0"
+serde = { version = "1.0.228", features = ["derive"] }
+serde_json = { version = "1.0.149", features = ["preserve_order"] }
+uuid = { version = "1.19.0", features = ["v4", "serde"] }
+
+[dev-dependencies]
+tempfile = "3.23.0"
diff --git a/crates/ai-toolbox-storage/src/backup.rs b/crates/ai-toolbox-storage/src/backup.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0d1304354bc2f9b297a0981a1090ea6a65eb6f74
--- /dev/null
+++ b/crates/ai-toolbox-storage/src/backup.rs
@@ -0,0 +1,21 @@
+use std::path::Path;
+
+use rusqlite::Connection;
+
+use super::health;
+
+pub fn backup_to_path(conn: &Connection, backup_path: &Path) -> Result<(), String> {
+    health::checkpoint_truncate(conn)?;
+    conn.backup(rusqlite::MAIN_DB, backup_path, None)
+        .map_err(|error| {
+            format!(
+                "Failed to create SQLite backup {}: {error}",
+                backup_path.display()
+            )
+        })
+}
+
+pub fn vacuum(conn: &Connection) -> Result<(), String> {
+    conn.execute_batch("VACUUM;")
+        .map_err(|error| format!("Failed to vacuum SQLite database: {error}"))
+}
