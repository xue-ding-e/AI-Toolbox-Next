-                "{source_label} contains empty display_name for {}",
-                item.model_id
-            ));
-        }
-
-        item.input_cost_per_million = validate_cost(
-            source_label,
-            &item.model_id,
-            "input_cost_per_million",
-            &item.input_cost_per_million,
-        )?;
-        item.output_cost_per_million = validate_cost(
-            source_label,
-            &item.model_id,
