+        "total_attempt_count",
+        "INTEGER NOT NULL DEFAULT 1",
+    )?;
+    conn.execute_batch(
+        "CREATE INDEX IF NOT EXISTS idx_request_logs_stream_outcome
+            ON proxy_request_logs(stream_outcome);",
+    )
+    .map_err(|error| format!("Failed to create proxy gateway stream outcome index: {error}"))
