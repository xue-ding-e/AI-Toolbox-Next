+                    fs::write(&target, b"synthetic hardlink").unwrap();
+                    fs::set_permissions(&target, fs::Permissions::from_mode(0o600)).unwrap();
+                    fs::hard_link(target, &path).unwrap();
+                }
+                "directory" => fs::create_dir(&path).unwrap(),
+                _ => unreachable!(),
+            }
+            let before = fs::symlink_metadata(&path).unwrap();
+            assert!(matches!(ContextService::attach(&owner, &db), Err(ServiceError::Storage)), "{leaf}: {kind}");
+            let after = fs::symlink_metadata(&path).unwrap();
+            assert_eq!((before.ino(), before.mode()), (after.ino(), after.mode()));
+            if kind == "directory" { fs::remove_dir(&path).unwrap(); }
+            else { fs::remove_file(&path).unwrap(); }
+            if existed { fs::rename(&held, &path).unwrap(); }
+            let service = ContextService::attach(&owner, &db).unwrap();
+            drop(service);
+            drop(db);
+            drop(owner);
+        }
+    }
