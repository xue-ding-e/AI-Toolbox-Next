+//! Internal Linux ConfigOnly service. No CLI, GUI or transport entry is enabled.
+//! All data paths are fixed by the acquired owner and existing master data.
+use std::{fs, path::Path, os::unix::fs::MetadataExt};
+use ai_toolbox_codex_config::plan::{plan_context_projection, ContextPatch, Target};
+use ai_toolbox_storage::{SqliteDbState, SQLITE_DATABASE_FILE, codex_context_journal as journal};
+use journal::{AdvanceResult, FailureCode, InsertResult, JournalEntry, JournalInput, Lookup, Phase};
+use rusqlite::Transaction;
+use sha2::{Digest, Sha256};
+use crate::{codex_master::{read_master, patch_master, MasterSnapshot, MasterError}, config_file::{ConfigFile, ConfigFileErrorReason},
+    owner::{OwnerPermit, ProfileIdentity, ProfileOwner, RuntimeResourceIdentity}};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ServiceError {
+    Ownership, Storage, InvalidMaster, InvalidRequest, ProviderChanged, RevisionConflict,
+    RuntimeUnsupported, FileUnavailable, JournalConflict, JournalInvalid, PersistenceUncertain,
+    PhasePersistence { last_committed: Phase }, Interrupted,
+}
+
+pub(crate) struct ContextRequest {
+    pub schema_version: u32,
+    pub request_id: String,
+    pub expected_provider_id: String,
+    pub expected_revision: String,
+    pub target: Target,
+    pub patch: ContextPatch,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ContextStatus {
+    pub phase: Phase,
+    pub failure: Option<FailureCode>,
+    pub replay: bool,
+    pub context: Option<i64>,
+    pub auto_compact: Option<i64>,
+}
+impl ContextStatus {
+    fn from_entry(entry: JournalEntry, replay: bool) -> Self {
+        Self { phase: if replay { entry.replay_phase() } else { entry.phase },
+            failure: entry.failure, replay, context: entry.input.context,
+            auto_compact: entry.input.auto_compact }
+    }
+    // Reserved for the eventual typed adapter; partial states never mean success.
+    pub(crate) fn exit_code(&self) -> i32 { if self.phase == Phase::Verified { 0 } else { 3 } }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Checkpoint {
+    None,
+    #[cfg(test)] BeforeSaveCommit,
+    #[cfg(test)] AfterSaved,
+    #[cfg(test)] AfterStarted,
+    #[cfg(test)] AfterWrite,
+    #[cfg(test)] AfterProjected,
+    #[cfg(test)] StartedCommitRollback,
+    #[cfg(test)] VerifiedCommitRollback,
+    #[cfg(test)] PreflightDrift,
+    #[cfg(test)] NoopReadbackDrift,
+    #[cfg(test)] ProjectedReadbackDrift,
+    #[cfg(test)] PhaseWriteReadOnly,
+    #[cfg(test)] ReplaceDrift,
+}
+
+// Declaration order closes SQLite before dropping the lifetime profile lease.
+pub(crate) struct ContextService {
+    db: SqliteDbState,
+    owner: OwnerPermit,
+    database_inode: (u64, u64),
+}
+
+fn master_error(error:MasterError)->ServiceError {
+    match error {MasterError::Storage=>ServiceError::Storage,MasterError::Conflict=>ServiceError::RevisionConflict,_=>ServiceError::InvalidMaster}
+}
+fn journal_error(error:journal::JournalError)->ServiceError {
+    match error {journal::JournalError::Storage(_)=>ServiceError::Storage,
+        journal::JournalError::FingerprintConflict=>ServiceError::JournalConflict,
+        _=>ServiceError::JournalInvalid}
+}
+
+fn valid_patch(patch:ContextPatch)->bool {
+    let values=[patch.model_context_window,patch.model_auto_compact_token_limit];
+    values.iter().any(Option::is_some) && values.into_iter().flatten().all(|v|v>0 && v<=i64::MAX as u64)
+        && !matches!((patch.model_context_window,patch.model_auto_compact_token_limit),(Some(c),Some(a)) if a>c)
+}
+
+// Constructed only after a new Advanced start and its successful commit.
+// Replay cannot produce this non-cloneable private capability.
+struct CommittedStart;
+fn project(_start:CommittedStart,file:ConfigFile<'_, '_>,candidate:&[u8])
+    ->Result<Vec<u8>,crate::config_file::ConfigFileError> {file.replace(candidate)}
+
+fn valid_id(value:&str)->bool {
+    !value.is_empty() && value.len()<=128 && value.bytes().all(|b|b.is_ascii_alphanumeric() || b==b'-' || b==b'_')
+}
+
+fn digest(parts: &[&[u8]]) -> String {
+    let mut h = Sha256::new();
+    for part in parts { h.update((part.len() as u64).to_le_bytes()); h.update(part); }
+    format!("{:x}", h.finalize())
+}
+fn database_identity(path: &Path) -> Result<(u64,u64),ServiceError> {
+    let m = fs::symlink_metadata(path).map_err(|_| ServiceError::Storage)?;
+    let uid = crate::owner::linux::current_uid().map_err(|_| ServiceError::Ownership)?;
+    if !m.is_file() || m.uid()!=uid || m.nlink()!=1 || m.mode() & 0o022 != 0 {
+        return Err(ServiceError::Storage);
+    }
+    Ok((m.dev(),m.ino()))
+}
+
+impl ContextService {
+    /// Writer initialization only, not a read-command implementation. Requires
+    /// an existing file database; shared storage initialization may seed/migrate.
+    pub(crate) fn open(profile: &Path) -> Result<Self,ServiceError> {
+        let identity=ProfileIdentity::existing(profile).map_err(|_| ServiceError::Ownership)?;
+        let owner=ProfileOwner::acquire(identity).map_err(|_| ServiceError::Ownership)?;
+        let path=owner.profile().canonical_path().join(SQLITE_DATABASE_FILE);
+        let database_inode=database_identity(&path)?;
+        for suffix in ["-wal", "-shm"] {
+            let side=path.with_file_name(format!("{SQLITE_DATABASE_FILE}{suffix}"));
+            match fs::symlink_metadata(&side) {
+                Ok(_) => { database_identity(&side)?; },
+                Err(e) if e.kind()==std::io::ErrorKind::NotFound => (),
+                Err(_) => return Err(ServiceError::Storage),
+            }
+        }
+        owner.ensure_current().map_err(|_| ServiceError::Ownership)?;
+        let db=SqliteDbState::open(path.clone()).map_err(|_| ServiceError::Storage)?;
+        owner.ensure_current().map_err(|_| ServiceError::Ownership)?;
+        if database_identity(&path)?!=database_inode { return Err(ServiceError::Storage); }
+        Ok(Self { db, owner, database_inode })
+    }
+    fn ensure_current(&self) -> Result<(),ServiceError> {
+        self.owner.ensure_current().map_err(|_| ServiceError::Ownership)?;
+        if database_identity(self.db.db_path())?!=self.database_inode { return Err(ServiceError::Storage); }
+        Ok(())
+    }
+    fn master(&self)->Result<MasterSnapshot,ServiceError> {
+        self.db.with_conn(|c| Ok(read_master(c))).map_err(|_|ServiceError::Storage)?
+            .map_err(master_error)
+    }
+    fn runtime(master:&MasterSnapshot)->Result<RuntimeResourceIdentity,ServiceError> {
+        RuntimeResourceIdentity::existing(master.explicit_root().map_err(|_|ServiceError::RuntimeUnsupported)?)
+            .map_err(|_|ServiceError::RuntimeUnsupported)
+    }
+    fn revision(&self,master:&MasterSnapshot,runtime:&RuntimeResourceIdentity,live:&[u8])->Result<String,ServiceError> {
+        let key=runtime.key(); let p=self.owner.profile().key();
+        Ok(digest(&[b"codex-context-revision-v1",&p.device.to_le_bytes(),&p.inode.to_le_bytes(),
+            &key.device.to_le_bytes(),&key.inode.to_le_bytes(),
+            &master.revision_bytes().map_err(|_|ServiceError::InvalidMaster)?,live]))
+    }
+    /// Reads only through an already initialized owner; does not create a new
+    /// profile, database or default provider. Runtime lease is an internal effect.
+    pub(crate) fn current_revision(&self)->Result<(String,String),ServiceError> {
+        self.ensure_current()?;
+        let writer=self.owner.try_writer().map_err(|_|ServiceError::Ownership)?;
+        let master=self.master()?; let runtime=Self::runtime(&master)?;
+        let resources=writer.acquire_resources(vec![runtime.clone()]).map_err(|_|ServiceError::Ownership)?;
+        let file=ConfigFile::read(&writer,&resources,&runtime).map_err(|_|ServiceError::FileUnavailable)?;
+        Ok((self.revision(&master,&runtime,file.bytes())?,master.provider_id))
+    }
+    fn fingerprint(&self,r:&ContextRequest)->String {
+        let key=self.owner.profile().key();
+        let target=match r.target {Target::Common=>b"common".as_slice(),Target::Provider=>b"provider".as_slice()};
+        let patch=serde_json::to_vec(&(r.patch.model_context_window,r.patch.model_auto_compact_token_limit)).expect("integer options serialize");
+        digest(&[b"codex-context-config-only-v1",&key.device.to_le_bytes(),&key.inode.to_le_bytes(),
+            r.request_id.as_bytes(),r.expected_provider_id.as_bytes(),r.expected_revision.as_bytes(),target,&patch])
+    }
+    fn lookup(&self,r:&ContextRequest,fingerprint:&str)->Result<Lookup,ServiceError> {
+        self.db.with_conn(|c|Ok(journal::lookup(c,&r.request_id,fingerprint)))
+            .map_err(|_|ServiceError::Storage)?.map_err(journal_error)
+    }
+    /// Only successful typed operations commit. In particular never pass
+    /// Ok(Err(..)) to helpers::db_transaction, whose Ok branch commits.
+    fn transaction<T>(&self,operation:impl FnOnce(&Transaction<'_>)->Result<T,ServiceError>)->Result<T,ServiceError> {
+        self.db.with_conn_mut(|c| {
+            let outcome=(|| {
+                let tx=c.transaction().map_err(|_|ServiceError::Storage)?;
+                let result=operation(&tx)?;
+                tx.commit().map_err(|_|ServiceError::PersistenceUncertain)?;
+                Ok(result)
+            })();
+            Ok(outcome)
+        }).map_err(|_|ServiceError::Storage)?
+    }
+    fn advance(&self,r:&ContextRequest,fp:&str,from:Phase,to:Phase,failure:Option<FailureCode>)->Result<JournalEntry,ServiceError> {
+        self.advance_at(r,fp,from,to,failure,Checkpoint::None)
+    }
+    fn advance_at(&self,r:&ContextRequest,fp:&str,from:Phase,to:Phase,failure:Option<FailureCode>,checkpoint:Checkpoint)->Result<JournalEntry,ServiceError> {
+        self.transaction(|tx| {
+            let entry=match journal::advance(tx,&r.request_id,fp,from,to,failure)
+                .map_err(journal_error)? {
+                AdvanceResult::Advanced(entry)=>entry,
+                AdvanceResult::Replay(_)=>return Err(ServiceError::JournalConflict),
+            };
+            // Synthetic pre-commit transaction errors, not real COMMIT/I/O faults.
+            #[cfg(test)] if (to==Phase::ProjectionStarted && checkpoint==Checkpoint::StartedCommitRollback)
+                || (to==Phase::Verified && checkpoint==Checkpoint::VerifiedCommitRollback) {
+                return Err(ServiceError::Interrupted);
+            }
+            Ok(entry)
+        }).map_err(|error| match error {
+            ServiceError::Storage=>ServiceError::PhasePersistence {last_committed:from},
+            other=>other,
+        })
+    }
+    pub(crate) fn execute(&self,r:&ContextRequest)->Result<ContextStatus,ServiceError> {
+        self.execute_at(r,Checkpoint::None)
+    }
+    fn execute_at(&self,r:&ContextRequest,checkpoint:Checkpoint)->Result<ContextStatus,ServiceError> {
+        if r.schema_version!=1 || !valid_patch(r.patch) || !valid_id(&r.request_id) || !valid_id(&r.expected_provider_id) || r.expected_revision.len()!=64
+            || !r.expected_revision.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) {
+            return Err(ServiceError::InvalidRequest);
+        }
+        self.ensure_current()?;
+        let writer=self.owner.try_writer().map_err(|_|ServiceError::Ownership)?;
+        let fp=self.fingerprint(r);
+        // Replay precedes provider/runtime/revision inspection, including after
+        // this same operation changed the master data or the live file.
+        if let Lookup::Replay(entry)=self.lookup(r,&fp)? { return Ok(ContextStatus::from_entry(entry,true)); }
+        let master=self.master()?;
+        if master.provider_id!=r.expected_provider_id { return Err(ServiceError::ProviderChanged); }
+        let runtime=Self::runtime(&master)?;
+        let resources=writer.acquire_resources(vec![runtime.clone()]).map_err(|_|ServiceError::Ownership)?;
+        let file=ConfigFile::read(&writer,&resources,&runtime).map_err(|_|ServiceError::FileUnavailable)?;
+        if self.revision(&master,&runtime,file.bytes())?!=r.expected_revision { return Err(ServiceError::RevisionConflict); }
+        let live=std::str::from_utf8(file.bytes()).map_err(|_|ServiceError::FileUnavailable)?;
+        let plan=plan_context_projection(live,&master.common_config,&master.provider_config,r.target,r.patch)
+            .map_err(|_|ServiceError::InvalidRequest)?;
+        let input=JournalInput {request_id:r.request_id.clone(),provider_id:master.provider_id.clone(),
+            request_fingerprint:fp.clone(),expected_revision:r.expected_revision.clone(),
+            planned_live_digest:digest(&[plan.live_candidate.as_bytes()]),context:plan.master.context.value,
+            auto_compact:plan.master.auto_compact.value,master_changed:plan.master.changed,live_changed:plan.live_changed};
+        let saved=self.transaction(|tx| {
+            if !matches!(journal::lookup(tx,&r.request_id,&fp).map_err(journal_error)?,Lookup::Missing) {
+                return Err(ServiceError::JournalConflict);
+            }
+            patch_master(tx,&master,r.target,&plan.master.candidate).map_err(master_error)?;
+            let entry=match journal::insert_saved(tx,input).map_err(journal_error)? {
+                InsertResult::Inserted(entry)=>entry,InsertResult::Replay(_)=>return Err(ServiceError::JournalConflict),
+            };
+            #[cfg(test)] if checkpoint==Checkpoint::BeforeSaveCommit {return Err(ServiceError::Interrupted);}
+            Ok(entry)
+        })?;
+        #[cfg(test)] if checkpoint==Checkpoint::AfterSaved {return Err(ServiceError::Interrupted);}
+        #[cfg(test)] if checkpoint==Checkpoint::PreflightDrift {
+            fs::write(runtime.canonical_path().join("config.toml"),b"# synthetic external drift\n").unwrap();
+        }
+        if file.preflight().is_err() {
+            let entry=self.advance(r,&fp,Phase::SavedOnly,Phase::SavedOnly,Some(FailureCode::ProjectionPreflightFailed))?;
+            return Ok(ContextStatus::from_entry(entry,false));
+        }
+        if !plan.live_changed {
+            #[cfg(test)] if checkpoint==Checkpoint::NoopReadbackDrift {
+                fs::write(runtime.canonical_path().join("config.toml"),b"# synthetic external drift\n").unwrap();
+            }
+            let result=file.readback();
+            let (next,failure)=match result {
+                Ok(bytes) if digest(&[&bytes])==saved.input.planned_live_digest => (Phase::Verified,None),
+                Ok(_)=>(Phase::SavedOnly,Some(FailureCode::ReadbackMismatch)),
+                Err(error)=>(Phase::SavedOnly,Some(match error.reason() {
+                    ConfigFileErrorReason::ConfigChanged | ConfigFileErrorReason::ReadbackMismatch => FailureCode::ReadbackMismatch,
+                    _ => FailureCode::ReadbackFailed,
+                })),
+            };
+            return self.advance(r,&fp,Phase::SavedOnly,next,failure).map(|e|ContextStatus::from_entry(e,false));
+        }
+        #[cfg(test)] if checkpoint==Checkpoint::PhaseWriteReadOnly {
+            self.db.with_conn(|c|c.execute_batch("PRAGMA query_only = ON").map_err(|_|"synthetic fixture".into())).unwrap();
+        }
+        self.advance_at(r,&fp,Phase::SavedOnly,Phase::ProjectionStarted,None,checkpoint)?;
+        let committed_start=CommittedStart;
+        #[cfg(test)] if checkpoint==Checkpoint::AfterStarted {return Err(ServiceError::Interrupted);}
+        #[cfg(test)] if checkpoint==Checkpoint::ReplaceDrift {
+            fs::write(runtime.canonical_path().join("config.toml"),b"# synthetic external drift\n").unwrap();
+        }
+        // Any failure after the durable start is conservatively uncertain; no
+        // automatic retry or rollback can assume rename did not happen.
+        match project(committed_start,file,plan.live_candidate.as_bytes()) {
+            Ok(_)=>(),
+            Err(_)=>return self.advance(r,&fp,Phase::ProjectionStarted,Phase::ProjectionUncertain,
+                Some(FailureCode::ProjectionOutcomeUnknown)).map(|e|ContextStatus::from_entry(e,false)),
+        };
+        #[cfg(test)] if checkpoint==Checkpoint::AfterWrite {return Err(ServiceError::Interrupted);}
+        self.advance(r,&fp,Phase::ProjectionStarted,Phase::ProjectedUnverified,None)?;
+        #[cfg(test)] if checkpoint==Checkpoint::AfterProjected {return Err(ServiceError::Interrupted);}
+        #[cfg(test)] if checkpoint==Checkpoint::ProjectedReadbackDrift {
+            fs::write(runtime.canonical_path().join("config.toml"),b"# synthetic external drift\n").unwrap();
+        }
+        let (phase,failure)=match ConfigFile::read(&writer,&resources,&runtime) {
+            Ok(current) if digest(&[current.bytes()])==saved.input.planned_live_digest => (Phase::Verified,None),
+            Ok(_)=>(Phase::ProjectedUnverified,Some(FailureCode::ReadbackMismatch)),
+            Err(_)=>(Phase::ProjectedUnverified,Some(FailureCode::ReadbackFailed)),
+        };
+        self.advance_at(r,&fp,Phase::ProjectedUnverified,phase,failure,checkpoint).map(|e|ContextStatus::from_entry(e,false))
+    }
+}
