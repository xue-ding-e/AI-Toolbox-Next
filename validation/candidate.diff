+  supportsReasoningEffort: true, baseUrl, apiBackend: 'chat_completions',
+};
+let providers = [{
+  id: 'fixture-grok', name: 'Synthetic Grok Fixture', category: 'custom',
+  settingsConfig: JSON.stringify({
+    auth: {}, baseUrl, config: '',
+    ...(scenario !== 'new' ? { defaultModelKey: 'grok-4.5' } : {}),
