+use super::{collect_stream, sse_data_values, AiProtocol, ConversionRoute};
+use serde_json::{json, Value};
+
+const REUSED_UPSTREAM_ID: &str = "upstream_reused";
+const TOOL_CALL_ID: &str = "call_keep_me";
+const SUMMARY: &str = "Plan 检查.";
+
+fn reasoning_source_stream(source: AiProtocol) -> String {
+    let values = match source {
+        AiProtocol::OpenAiChat => vec![
+            json!({"id": REUSED_UPSTREAM_ID, "choices": [{"index": 0, "delta": {"role": "assistant"}}]}),
+            json!({"id": REUSED_UPSTREAM_ID, "choices": [{"index": 0, "delta": {"reasoning_content": "Plan "}}]}),
+            json!({"id": REUSED_UPSTREAM_ID, "choices": [{"index": 0, "delta": {"reasoning_content": "检查."}}]}),
+            json!({"id": REUSED_UPSTREAM_ID, "choices": [{"index": 0, "delta": {"tool_calls": [{"index": 0, "id": TOOL_CALL_ID, "type": "function", "function": {"name": "read_file", "arguments": "{\"path\":\"a.txt\"}"}}]}}]}),
+            json!({"id": REUSED_UPSTREAM_ID, "choices": [{"index": 0, "delta": {}, "finish_reason": "tool_calls"}], "usage": {"prompt_tokens": 2, "completion_tokens": 3, "total_tokens": 5}}),
+        ],
+        AiProtocol::AnthropicMessages => vec![
+            json!({"type": "message_start", "message": {"id": REUSED_UPSTREAM_ID, "model": "model-a", "usage": {"input_tokens": 2, "output_tokens": 0}}}),
+            json!({"type": "content_block_start", "index": 0, "content_block": {"type": "thinking", "thinking": ""}}),
+            json!({"type": "content_block_delta", "index": 0, "delta": {"type": "thinking_delta", "thinking": "Plan "}}),
+            json!({"type": "content_block_delta", "index": 0, "delta": {"type": "thinking_delta", "thinking": "检查."}}),
+            json!({"type": "content_block_stop", "index": 0}),
+            json!({"type": "content_block_start", "index": 1, "content_block": {"type": "tool_use", "id": TOOL_CALL_ID, "name": "read_file", "input": {}}}),
+            json!({"type": "content_block_delta", "index": 1, "delta": {"type": "input_json_delta", "partial_json": "{\"path\":\"a.txt\"}"}}),
+            json!({"type": "content_block_stop", "index": 1}),
+            json!({"type": "message_delta", "delta": {"stop_reason": "tool_use"}, "usage": {"output_tokens": 3}}),
+            json!({"type": "message_stop"}),
+        ],
+        AiProtocol::GeminiNative => vec![
+            json!({"responseId": REUSED_UPSTREAM_ID, "candidates": [{"content": {"role": "model", "parts": [{"thought": true, "text": "Plan "}]}}]}),
+            json!({"responseId": REUSED_UPSTREAM_ID, "candidates": [{"content": {"role": "model", "parts": [{"thought": true, "text": "检查."}]}}]}),
+            json!({"responseId": REUSED_UPSTREAM_ID, "candidates": [{"content": {"role": "model", "parts": [{"functionCall": {"id": TOOL_CALL_ID, "name": "read_file", "args": {"path": "a.txt"}}}]}}]}),
+            json!({"responseId": REUSED_UPSTREAM_ID, "candidates": [{"finishReason": "STOP"}], "usageMetadata": {"promptTokenCount": 2, "candidatesTokenCount": 3, "totalTokenCount": 5}}),
+        ],
+        AiProtocol::OpenAiResponses => panic!("identity uses a separate raw-byte control"),
+    };
+    values
+        .into_iter()
+        .map(|value| match value.get("type").and_then(Value::as_str) {
+            Some(event) => format!("event: {event}\ndata: {value}\n\n"),
+            None => format!("data: {value}\n\n"),
+        })
+        .collect()
+}
+
+fn converted_reasoning_events(source: AiProtocol) -> Vec<Value> {
+    // The shared helper feeds 11-byte chunks through the production SSE facade
+    // and StreamKernel, including chunk splits inside the UTF-8 summary text.
+    sse_data_values(&collect_stream(
+        ConversionRoute::new(source, AiProtocol::OpenAiResponses),
+        reasoning_source_stream(source),
+    ))
+}
+
+fn reasoning_added_id(values: &[Value]) -> &str {
+    let added = values
+        .iter()
+        .filter(|value| {
+            value["type"] == "response.output_item.added"
+                && value["item"]["type"] == "reasoning"
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(added.len(), 1, "exactly one reasoning item must open");
+    added[0]["item"]["id"].as_str().expect("reasoning id")
+}
+
+fn assert_reasoning_prefix(source: AiProtocol) {
+    let values = converted_reasoning_events(source);
+    let id = reasoning_added_id(&values);
+    assert!(
+        id.starts_with("rs_") && id.len() > 3,
+        "{source:?} generated an invalid Responses reasoning id: {id}"
+    );
+}
+
+fn assert_independent_reasoning_ids(source: AiProtocol) {
+    // Identical input deliberately reuses the upstream envelope and tool IDs.
+    // Request isolation must not rely on a provider supplying a unique ID.
+    let first = converted_reasoning_events(source);
+    let second = converted_reasoning_events(source);
+    assert_ne!(
+        reasoning_added_id(&first),
+        reasoning_added_id(&second),
+        "{source:?} reused a reasoning item id across independent streams"
+    );
+}
+
+#[test]
+fn chat_to_responses_reasoning_id_uses_rs_prefix() {
+    assert_reasoning_prefix(AiProtocol::OpenAiChat);
+}
+
+#[test]
+fn anthropic_to_responses_reasoning_id_uses_rs_prefix() {
+    assert_reasoning_prefix(AiProtocol::AnthropicMessages);
+}
+
+#[test]
+fn gemini_to_responses_reasoning_id_uses_rs_prefix() {
+    assert_reasoning_prefix(AiProtocol::GeminiNative);
+}
+
+#[test]
+fn chat_to_responses_reasoning_ids_are_unique_with_reused_upstream_id() {
+    assert_independent_reasoning_ids(AiProtocol::OpenAiChat);
+}
+
+#[test]
+fn anthropic_to_responses_reasoning_ids_are_unique_with_reused_upstream_id() {
+    assert_independent_reasoning_ids(AiProtocol::AnthropicMessages);
+}
+
+#[test]
+fn gemini_to_responses_reasoning_ids_are_unique_with_reused_upstream_id() {
+    assert_independent_reasoning_ids(AiProtocol::GeminiNative);
+}
+
+#[test]
+fn converted_reasoning_identity_summary_and_tool_call_survive_the_full_lifecycle() {
+    for source in [
+        AiProtocol::OpenAiChat,
+        AiProtocol::AnthropicMessages,
+        AiProtocol::GeminiNative,
+    ] {
+        let values = converted_reasoning_events(source);
+        let id = reasoning_added_id(&values);
+        let related = values
+            .iter()
+            .filter(|value| {
+                value["item"]["type"] == "reasoning"
+                    || value["type"]
+                        .as_str()
+                        .is_some_and(|kind| kind.starts_with("response.reasoning_summary_"))
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(
+            related
+                .iter()
+                .map(|value| value["type"].as_str().expect("event type"))
+                .collect::<Vec<_>>(),
+            [
+                "response.output_item.added",
+                "response.reasoning_summary_part.added",
+                "response.reasoning_summary_text.delta",
+                "response.reasoning_summary_text.delta",
+                "response.reasoning_summary_text.done",
+                "response.reasoning_summary_part.done",
+                "response.output_item.done",
+            ],
+            "{source:?} reasoning lifecycle"
+        );
+        for event in &related {
+            let event_id = event
+                .get("item_id")
+                .or_else(|| event.pointer("/item/id"))
+                .and_then(Value::as_str)
+                .expect("reasoning event identity");
+            assert_eq!(event_id, id, "{source:?} changed an open reasoning id");
+            assert_eq!(event["output_index"], 0);
+        }
+        assert_eq!(related[0]["item"]["summary"], json!([]));
+        assert_eq!(related[2]["delta"], "Plan ");
+        assert_eq!(related[3]["delta"], "检查.");
+        assert_eq!(related[4]["text"], SUMMARY);
+        assert_eq!(related[5]["part"]["text"], SUMMARY);
+        let reasoning_done = &related[6]["item"];
+        assert_eq!(reasoning_done["status"], "completed");
+        assert_eq!(
+            reasoning_done["summary"],
+            json!([{"type": "summary_text", "text": SUMMARY}])
+        );
+
+        let completed = values
+            .iter()
+            .filter(|value| value["type"] == "response.completed")
+            .collect::<Vec<_>>();
+        assert_eq!(completed.len(), 1, "{source:?} terminal must be unique");
+        let output = completed[0]["response"]["output"]
+            .as_array()
+            .expect("completed output");
+        assert_eq!(output.len(), 2);
+        assert_eq!(output[0], *reasoning_done);
+        assert_eq!(output[0]["id"], id);
+        assert_eq!(output[1]["type"], "function_call");
+        assert_eq!(output[1]["call_id"], TOOL_CALL_ID);
+        assert_eq!(output[1]["name"], "read_file");
+        assert_eq!(output[1]["arguments"], "{\"path\":\"a.txt\"}");
+        for event_type in ["response.output_item.added", "response.output_item.done"] {
+            let tools = values
+                .iter()
+                .filter(|value| {
+                    value["type"] == event_type && value["item"]["type"] == "function_call"
+                })
+                .collect::<Vec<_>>();
+            assert_eq!(tools.len(), 1);
+            assert_eq!(tools[0]["item"]["call_id"], TOOL_CALL_ID);
+            assert_eq!(tools[0]["item"]["id"], output[1]["id"]);
+        }
+    }
+}
+
+#[test]
+fn responses_identity_preserves_native_reasoning_id_and_ciphertext_bytes() {
+    // This is an identity-route control, not a StreamKernel roundtrip. The
+    // opaque ciphertext is synthetic and must never be interpreted or replaced.
+    let input = concat!(
+        ": native reasoning control\r\n",
+        "id: native-event-1\r\n",
+        "event: response.output_item.done\r\n",
+        "data: {\"type\":\"response.output_item.done\",\"output_index\":0,\"item\":{\"id\":\"rs_native_keep\",\"type\":\"reasoning\",\"summary\":[],\"encrypted_content\":\"fixture-ciphertext-keep\\u003d\"}}\r\n\r\n",
+        "event: response.completed\n",
+        "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_native\",\"status\":\"completed\",\"output\":[{\"id\":\"rs_native_keep\",\"type\":\"reasoning\",\"summary\":[],\"encrypted_content\":\"fixture-ciphertext-keep\\u003d\"}]}}\n\n",
+        " \t\r\n"
+    );
+    let output = collect_stream(
+        ConversionRoute::new(AiProtocol::OpenAiResponses, AiProtocol::OpenAiResponses),
+        input.to_string(),
+    );
+    assert_eq!(output.as_bytes(), input.as_bytes());
+}
